// MMPraise Volunteer Registration — data model
//
// Design notes:
//  * Fields that are filtered, sorted or reported on live in typed columns
//    (fast, indexable, constrained). Only department-specific questions use the
//    dynamic question engine (DepartmentQuestion/ApplicationAnswer), so admins can
//    add questions without a deploy while core reporting stays fast.
//  * Health information is isolated in ApplicationHealthInfo so it can never be
//    accidentally included in a volunteer list query.
//  * Uploaded files are referenced by opaque ids; the storage key is never exposed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  VOLUNTEER
  SUPER_ADMIN
  REGISTRATION_ADMIN
  DEPARTMENT_HEAD
  REVIEWER
  MEDICAL_INFO_OFFICER
  COMMUNICATION_OFFICER
}

enum Gender {
  MALE
  FEMALE
}

enum AgeRange {
  AGE_00_15
  AGE_16_20
  AGE_21_25
  AGE_26_30
  AGE_31_35
  AGE_36_40
  AGE_41_45
  AGE_46_50
  AGE_51_PLUS
}

enum Denomination {
  RCCG
  OTHER_CHRISTIAN
  NON_CHRISTIAN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  WAITLISTED
  REJECTED
  ASSIGNED
  CHECKED_IN
  COMPLETED
}

enum QuestionType {
  TEXT
  TEXTAREA
  EMAIL
  TEL
  NUMBER
  DATE
  RADIO
  CHECKBOX
  SELECT
  MULTISELECT
  FILE
  RATING
}

enum DocumentKind {
  PROFILE_PHOTO
  CERTIFICATE
  ANSWER_ATTACHMENT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ShiftPeriod {
  MORNING
  AFTERNOON
  EVENING
  OVERNIGHT
}

enum LookupCategory {
  OCCUPATION
  EDUCATION
  DISCOVERY_SOURCE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Where a contact message has got to. Deliberately not SubmissionStatus:
 * a message is triaged and answered, not approved or rejected for publication.
 */
/** Lifecycle of a whole CSV import. */
enum MigrationBatchStatus {
  DRAFT          // uploaded and mapped, not yet validated
  VALIDATED      // dry run complete, awaiting confirmation
  QUEUED         // confirmed, waiting for the worker
  IMPORTING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
}

/** What the importer decided to do with one CSV row. */
enum MigrationRowAction {
  CREATE          // no existing account — create a migrated one
  MATCH_EXISTING  // email already registered — link, never duplicate
  SKIP_DUPLICATE  // the same email appeared earlier in this file
  SKIP_INVALID
}

enum MigrationRowStatus {
  PENDING
  VALID
  WARNING
  INVALID
  IMPORTED
  FAILED
  SKIPPED
}

/**
 * Invitation delivery.
 *
 * SENT means the provider accepted the message, which is all SMTP can tell us.
 * DELIVERED is only ever set from a provider webhook, so the two are never
 * conflated — claiming delivery we cannot observe would be a lie to the team
 * chasing non-responders.
 */
enum InvitationStatus {
  NOT_QUEUED
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SUPPRESSED     // already activated, or excluded by an administrator
}

/** Work the queue has to do. Processed out of the request cycle. */
enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

/**
 * How urgent a message is, decided by the person triaging, never inferred.
 * Separate from AnnouncementPriority so the two can diverge without a shared
 * enum quietly coupling unrelated modules.
 */
enum ContactPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/**
 * Why someone is writing. Kept as an enum rather than free text so the inbox can
 * be filtered and routed without parsing subject lines.
 */
enum ContactCategory {
  GENERAL
  EVENT_INFORMATION
  REGISTRATION_SUPPORT
  VOLUNTEER
  MEDIA
  PARTNERSHIP
  DONATION
  OTHER
}

enum AnnouncementAudience {
  ALL_VOLUNTEERS
  DEPARTMENT
  APPROVED_ONLY
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  phone           String?   @unique
  passwordHash    String

  /**
   * The volunteer's permanent MMP number — `MMP2214059`.
   *
   * This is *the* registration number. A volunteer registers once and returns
   * each edition to mark availability, so the number identifies the person and
   * never changes: the legacy data shows codes issued in 2022 still attached to
   * people who served in 2026.
   *
   * Not to be confused with `VolunteerApplication.registrationId`, which is a
   * per-edition reference and is not shown to volunteers.
   *
   * Nullable only because accounts created before this column existed are
   * backfilled by migration; every account created since has one.
   */
  mmpCode         String?   @unique
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  deletionRequestedAt DateTime?

  /**
   * Migration state.
   *
   * `mustReviewProfile` gates the dashboard until a migrated person has
   * confirmed their details for the current edition. `migrationSource` records
   * which batch created them, so an import can always be traced back.
   */
  isPreviousEditionUser Boolean   @default(false)
  mustReviewProfile     Boolean   @default(false)
  migrationSource       String?
  profileReviewedAt     DateTime?

  /**
   * Administrative access state.
   *
   * Separate from `isActive`, which disables the whole account including
   * volunteering. These suspend only the administrative side: someone can lose
   * their reviewer access while remaining a volunteer with an application of
   * their own. `adminSuspendedUntil` expires on its own so temporary cover — a
   * leave of absence, an investigation — does not depend on anybody remembering
   * to switch it back on.
   */
  adminDisabledAt     DateTime?
  adminSuspendedUntil DateTime?
  adminNote           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles            UserRole[]
  departmentScopes UserDepartmentScope[]
  sessions         Session[]
  tokens           VerificationToken[]
  profile          VolunteerProfile?
  applications     VolunteerApplication[]
  documents        VolunteerDocument[]
  auditLogs        AuditLog[]              @relation("AuditActor")
  notesAuthored    AdminNote[]
  statusChanges    ApplicationStatusHistory[] @relation("StatusChangedBy")
  announcements    Announcement[]
  testimoniesReviewed TestimonySubmission[] @relation("TestimonyReviewer")
  testimoniesAssigned TestimonySubmission[] @relation("TestimonyAssignee")
  testimonyNotes      TestimonyNote[]       @relation("TestimonyNoteAuthor")
  contactMessagesHandled ContactMessage[]   @relation("ContactHandler")
  contactMessagesAssigned ContactMessage[]  @relation("ContactAssignee")
  contactNotes            ContactNote[]     @relation("ContactNoteAuthor")
  migrationBatches       MigrationBatch[]   @relation("MigrationCreator")
  migratedRecords        MigratedUserRecord[] @relation("MigratedRecordUser")
  previousParticipations PreviousEditionParticipation[]
  permissionGrants       AdminPermissionGrant[] @relation("PermissionSubject")
  permissionsGranted     AdminPermissionGrant[] @relation("PermissionGrantor")
  roleHistory            RoleAssignmentHistory[] @relation("RoleSubject")
  roleChangesMade        RoleAssignmentHistory[] @relation("RoleActor")
  outreachRunsCreated    OutreachRun[]           @relation("OutreachRunCreator")
  outreachAttempts       OutreachAttempt[]       @relation("OutreachAttempts")
  contactLogs            ParticipantContactLog[] @relation("ContactLogSubject")
  contactLogsAuthored    ParticipantContactLog[] @relation("ContactLogAuthor")

  @@index([createdAt])
  // Response-stage and reminder-eligibility scans over ~14k imported people.
  @@index([isPreviousEditionUser, emailVerifiedAt])
  @@map("users")
}

/**
 * A permission granted to, or withheld from, one administrator directly.
 *
 * Roles remain the primary grant: they are what an administrator is given, and
 * the six defaults cover almost every case. This table is the exception
 * mechanism — one reviewer who also needs to export, one department head who
 * must not — expressed without inventing a seventh role that exists for a
 * single person and is then never maintained.
 *
 * `granted` can be false, which is what makes it an *override* rather than an
 * additive list: a revoke beats the role default, so access can be narrowed as
 * well as widened, and a leaver can be cut off from one capability without
 * stripping their whole role.
 */
model AdminPermissionGrant {
  id         String  @id @default(cuid())
  userId     String
  /** A value from PERMISSIONS in src/lib/auth/rbac.ts. */
  permission String
  /** True adds the permission; false removes it even if a role grants it. */
  granted    Boolean @default(true)
  reason     String?

  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User  @relation("PermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  // One decision per permission per administrator; changing it updates in place
  // so the effective policy can never contain two contradictory rows.
  @@unique([userId, permission])
  @@index([permission])
  @@map("admin_permission_grants")
}

enum RoleChange {
  GRANTED
  REVOKED
  SUSPENDED
  RESTORED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
}

/**
 * Who gave whom which access, and when.
 *
 * The audit log records this too, but as one row among thousands of unrelated
 * events. This table answers "how did this person get this access?" directly,
 * survives audit-log retention trimming, and is what an administrator is shown
 * before they change somebody else's permissions.
 */
model RoleAssignmentHistory {
  id      String     @id @default(cuid())
  userId  String
  change  RoleChange
  /** The Role, or the permission key, depending on `change`. */
  subject String
  reason  String?

  actorId   String?
  createdAt DateTime @default(now())

  user  User? @relation("RoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("RoleActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("role_assignment_history")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

/// Restricts a DEPARTMENT_HEAD (or reviewer) to specific departments.
model UserDepartmentScope {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_department_scopes")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Database-backed fixed-window rate limiting (no Redis dependency required).
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Reference data — geography
// ---------------------------------------------------------------------------

model Country {
  id        String  @id @default(cuid())
  iso2      String  @unique
  iso3      String  @unique
  name      String
  phoneCode String
  emoji     String?
  hasStates Boolean @default(true)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  states   State[]
  profiles VolunteerProfile[]

  @@index([name])
  @@map("countries")
}

model State {
  id        String  @id @default(cuid())
  countryId String
  name      String
  code      String?
  isActive  Boolean @default(true)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  profiles VolunteerProfile[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("states")
}

// ---------------------------------------------------------------------------
// Reference data — church hierarchy (RCCG)
// ---------------------------------------------------------------------------

model ChurchContinent {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  regions   ChurchRegion[]

  @@map("church_continents")
}

model ChurchRegion {
  id          String  @id @default(cuid())
  continentId String?
  name        String  @unique
  code        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  continent ChurchContinent?  @relation(fields: [continentId], references: [id], onDelete: SetNull)
  provinces ChurchProvince[]
  profiles  VolunteerProfile[]

  @@index([continentId])
  @@map("church_regions")
}

model ChurchProvince {
  id        String  @id @default(cuid())
  regionId  String
  name      String
  code      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  region   ChurchRegion       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  zones    ChurchZone[]
  parishes Parish[]
  profiles VolunteerProfile[]

  @@unique([regionId, name])
  @@index([regionId])
  @@map("church_provinces")
}

model ChurchZone {
  id         String  @id @default(cuid())
  provinceId String
  name       String
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  province ChurchProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  areas    ChurchArea[]

  @@unique([provinceId, name])
  @@map("church_zones")
}

model ChurchArea {
  id        String  @id @default(cuid())
  zoneId    String
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  zone     ChurchZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  parishes Parish[]

  @@unique([zoneId, name])
  @@map("church_areas")
}

model Parish {
  id         String  @id @default(cuid())
  provinceId String?
  areaId     String?
  name       String
  address    String?
  isActive   Boolean @default(true)

  province ChurchProvince?    @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  area     ChurchArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  profiles VolunteerProfile[]

  @@index([provinceId])
  @@index([name])
  @@map("parishes")
}

/// Admin-manageable option lists (occupation, education, discovery source) so the
/// values can change without a code deploy.
model LookupOption {
  id           String         @id @default(cuid())
  category     LookupCategory
  value        String
  label        String
  requiresText Boolean        @default(false)
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)

  @@unique([category, value])
  @@index([category, isActive])
  @@map("lookup_options")
}

// ---------------------------------------------------------------------------
// Departments & the dynamic question engine
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions      DepartmentQuestion[]
  participations EditionParticipation[]
  scopes         UserDepartmentScope[]
  shifts        Shift[]
  announcements Announcement[]

  @@map("departments")
}

model DepartmentQuestion {
  id           String       @id @default(cuid())
  departmentId String
  key          String
  label        String
  helpText     String?
  type         QuestionType
  isRequired   Boolean      @default(false)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)

  // Type-specific constraints, all optional.
  maxLength        Int?
  minValue         Int?
  maxValue         Int?
  ratingMin        Int?
  ratingMax        Int?
  allowedMimeTypes String[] @default([])
  maxFileSizeKb    Int?
  placeholder      String?
  /// Optional regular expression applied to text answers (e.g. URL formats),
  /// enforced on both client and server.
  pattern        String?
  patternMessage String?

  // Conditional display: show only when the parent question's answer includes
  // one of parentOptionValues (or, for booleans, equals parentValue).
  parentQuestionId   String?
  parentOptionValues String[] @default([])

  department Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  parent     DepartmentQuestion?  @relation("QuestionConditional", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  children   DepartmentQuestion[] @relation("QuestionConditional")
  options    QuestionOption[]
  answers    ApplicationAnswer[]

  @@unique([departmentId, key])
  @@index([departmentId, isActive])
  @@map("department_questions")
}

model QuestionOption {
  id           String  @id @default(cuid())
  questionId   String
  value        String
  label        String
  /// "Other" style options that reveal a free-text input.
  requiresText Boolean @default(false)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  question DepartmentQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  ApplicationAnswerOption[]

  @@unique([questionId, value])
  @@map("question_options")
}

// ---------------------------------------------------------------------------
// Volunteer profile & application
// ---------------------------------------------------------------------------

model VolunteerProfile {
  id     String @id @default(cuid())
  userId String @unique

  firstName String
  lastName  String
  gender    Gender?
  ageRange  AgeRange?
  phone     String?
  phoneCountry String?

  // Guardian consent, required when the applicant is a minor.
  // AGE_16_20 straddles the age of majority, so minors are recorded explicitly
  // rather than inferred from the age band alone.
  isMinor         Boolean?
  guardianName    String?
  guardianPhone   String?
  guardianConsent Boolean @default(false)

  // Location
  countryId      String?
  stateId        String?
  stateNameOther String?
  city           String?
  addressLine    String?

  // Professional / educational
  occupation      String?
  occupationOther String?
  education       String?
  educationOther  String?

  // Church
  denomination     Denomination?
  churchRegionId   String?
  churchProvinceId String?
  parishId         String?
  parishNameOther  String?
  churchName       String?

  photoDocumentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  country  Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  state    State?            @relation(fields: [stateId], references: [id], onDelete: SetNull)
  region   ChurchRegion?     @relation(fields: [churchRegionId], references: [id], onDelete: SetNull)
  province ChurchProvince?   @relation(fields: [churchProvinceId], references: [id], onDelete: SetNull)
  parish   Parish?           @relation(fields: [parishId], references: [id], onDelete: SetNull)
  photo    VolunteerDocument? @relation("ProfilePhoto", fields: [photoDocumentId], references: [id], onDelete: SetNull)

  @@index([lastName, firstName])
  @@index([countryId, stateId])
  @@map("volunteer_profiles")
}

/**
 * A person's application to volunteer — made **once**.
 *
 * A volunteer does not re-apply every edition. They apply, they are approved,
 * and thereafter they return each edition to say they are available. That is
 * why this row is unique per user and why approval lives here rather than on
 * the per-edition record: `EditionParticipation`.
 *
 * The name is right, and always was. What was wrong was that this table used to
 * be created afresh every edition, dragging a returning volunteer back through
 * eight steps to re-enter a surname that had not changed.
 *
 * What stays here is what does not change between editions: who the person is,
 * why they want to serve, who to call in an emergency, and whether the
 * organisation has accepted them. What moves is anything they decide anew each
 * time — department, availability, consents.
 */
model VolunteerApplication {
  id             String            @id @default(cuid())
  /// `MMP-2027-000123`. Internal; the number a volunteer quotes is `User.mmpCode`.
  registrationId String            @unique
  /// One application per person. This is the whole point of the model.
  userId         String            @unique
  status         ApplicationStatus @default(DRAFT)
  currentStep    Int               @default(1)

  /// Autosaved wizard state for an in-progress draft. Cleared on submission.
  draftData Json?

  // Discovery & motivation — asked once.
  discoverySource String?
  discoveryOther  String?
  whyVolunteer    String?
  skillsExperience String?
  additionalInfo   String?

  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  decisionReason String?

  submissionIp        String?
  submissionUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergency      EmergencyContact?
  health         ApplicationHealthInfo?
  documents      VolunteerDocument[]
  statusHistory  ApplicationStatusHistory[]
  notes          AdminNote[]
  participations EditionParticipation[]

  @@index([status])
  @@index([submittedAt])
  @@map("volunteer_applications")
}

/**
 * Where a volunteer has got to in one edition.
 *
 * Approval is not repeated here — it belongs to the person and was granted
 * once. This records what they decide anew each time: which department, when
 * they can serve, and the consents they give for *this* edition.
 */
enum ParticipationStatus {
  /// Said they are available. The ordinary state between confirming and the rota.
  SIGNED_UP
  ASSIGNED
  CHECKED_IN
  COMPLETED
  /// Told us they can no longer serve this time. Their approval is untouched.
  WITHDRAWN
}

/**
 * One approved volunteer, in one edition.
 *
 * Unique on `(applicationId, edition)`: a volunteer takes part in an edition
 * once, and confirming twice must update rather than duplicate.
 *
 * Deliberately kept apart from `PreviousEditionParticipation`, which holds
 * imported legacy history. That table stores department as free text because
 * the 2022–2026 exports carry fifteen unnormalised department names; this one
 * references a real department row. Merging them would mean either losing the
 * legacy strings or weakening this foreign key, and both are worse than two
 * tables with one clear difference between them.
 */
model EditionParticipation {
  id            String @id @default(cuid())
  applicationId String
  /// "2027". Matches `eventConfig.edition`.
  edition       String
  year          Int?

  departmentId String?
  status       ParticipationStatus @default(SIGNED_UP)

  /// Availability summary; the dates themselves are in `VolunteerAvailability`.
  availableOvernight Boolean?

  // Consents, re-taken every edition and each stored with the time it was given.
  consentAccurate       Boolean   @default(false)
  consentTerms          Boolean   @default(false)
  consentDataProcessing Boolean   @default(false)
  consentCommunication  Boolean   @default(false)
  consentedAt           DateTime?

  /// When the volunteer confirmed they are taking part this edition.
  confirmedAt DateTime?
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application  VolunteerApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  department   Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  availability VolunteerAvailability[]
  answers      ApplicationAnswer[]
  assignments  ShiftAssignment[]

  @@unique([applicationId, edition])
  @@index([edition, status])
  // The confirmation predicate behind "Confirmed" and every response stage.
  @@index([edition, confirmedAt])
  @@index([departmentId, edition])
  @@map("edition_participations")
}

/// An answer to a department-specific question, for one edition.
///
/// Keyed to the participation, not the application: a volunteer who serves in
/// Media one edition and Medical the next has answered two different sets of
/// questions, and neither set should overwrite the other.
model ApplicationAnswer {
  id              String @id @default(cuid())
  participationId String
  questionId      String

  valueText   String?
  valueNumber Decimal? @db.Decimal(12, 2)
  valueBool   Boolean?
  valueDate   DateTime?
  documentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participation EditionParticipation     @relation(fields: [participationId], references: [id], onDelete: Cascade)
  question      DepartmentQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  document      VolunteerDocument?       @relation("AnswerDocument", fields: [documentId], references: [id], onDelete: SetNull)
  options       ApplicationAnswerOption[]

  @@unique([participationId, questionId])
  @@index([questionId])
  @@map("application_answers")
}

model ApplicationAnswerOption {
  id        String  @id @default(cuid())
  answerId  String
  optionId  String
  /// Free text captured when the chosen option requiresText (e.g. "Other").
  otherText String?

  answer ApplicationAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option QuestionOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([answerId, optionId])
  @@map("application_answer_options")
}

/// When a volunteer can serve in one edition — the thing they come back to say.
model VolunteerAvailability {
  id              String      @id @default(cuid())
  participationId String
  date            DateTime    @db.Date
  period          ShiftPeriod
  note            String?

  participation EditionParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, date, period])
  @@map("volunteer_availability")
}

model EmergencyContact {
  id            String @id @default(cuid())
  applicationId String @unique
  name          String
  relationship  String
  phone         String
  altPhone      String?

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

/// Restricted health information. Separate table so ordinary volunteer queries
/// cannot return it, and access is gated on the MEDICAL_INFO_OFFICER role.
model ApplicationHealthInfo {
  id            String   @id @default(cuid())
  applicationId String   @unique
  hasCondition  Boolean  @default(false)
  details       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_health_info")
}

model VolunteerDocument {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  kind          DocumentKind
  storageKey    String       @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  checksum      String?
  width         Int?
  height        Int?
  createdAt     DateTime     @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application VolunteerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  profilePhotoOf VolunteerProfile?  @relation("ProfilePhoto")
  answers     ApplicationAnswer[]   @relation("AnswerDocument")

  @@index([userId])
  @@map("volunteer_documents")
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  reason        String?
  createdAt     DateTime          @default(now())

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?                @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model AdminNote {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String?
  body          String
  createdAt     DateTime @default(now())

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("admin_notes")
}

// ---------------------------------------------------------------------------
// Scheduling & communication
// ---------------------------------------------------------------------------

model Shift {
  id           String      @id @default(cuid())
  departmentId String?
  name         String
  startsAt     DateTime
  endsAt       DateTime
  location     String?
  capacity     Int?
  period       ShiftPeriod
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments ShiftAssignment[]

  @@index([startsAt])
  @@map("shifts")
}

/// A shift given to a volunteer. Shifts belong to an edition by definition.
model ShiftAssignment {
  id              String   @id @default(cuid())
  shiftId         String
  participationId String
  assignedById    String?
  createdAt       DateTime @default(now())

  shift         Shift                @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  participation EditionParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([shiftId, participationId])
  @@map("shift_assignments")
}

model Announcement {
  id           String               @id @default(cuid())
  title        String
  body         String
  audience     AnnouncementAudience @default(ALL_VOLUNTEERS)
  departmentId String?
  publishedAt  DateTime?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  /**
   * Lifecycle.
   *
   * `publishedAt` is kept as the single fact about *when* something went live —
   * the volunteer dashboard already reads it and must keep working unchanged.
   * `status` records intent, which a timestamp cannot: a draft and a scheduled
   * post both have no `publishedAt`, and an expired one has the same
   * `publishedAt` it always had.
   */
  status       AnnouncementStatus @default(DRAFT)
  priority     AnnouncementPriority @default(NORMAL)
  /** When a scheduled announcement should go live. */
  scheduledFor DateTime?
  /** After this the announcement stops being shown. Null means indefinite. */
  expiresAt    DateTime?

  /** Where it appears. Email delivery is opt-in per announcement. */
  showOnDashboard Boolean @default(true)
  showAsBanner    Boolean @default(false)
  sendEmail       Boolean @default(false)
  /** Overrides the default subject when the announcement is emailed. */
  emailSubject    String?

  archivedAt   DateTime?
  updatedById  String?

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revisions  AnnouncementRevision[]
  deliveries AnnouncementDelivery[]

  @@index([publishedAt])
  @@index([status, scheduledFor])
  @@map("announcements")
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/**
 * A snapshot of an announcement's wording before it was changed.
 *
 * Written on every edit rather than diffed on read: an announcement can be
 * emailed to thousands of people, and "what exactly did we send?" must be
 * answerable afterwards even though the record has since been corrected.
 */
model AnnouncementRevision {
  id             String   @id @default(cuid())
  announcementId String
  version        Int
  title          String
  body           String
  /** The whole record at that moment, for fields not worth a column each. */
  snapshot       Json
  editedById     String?
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, version])
  @@map("announcement_revisions")
}

/**
 * One email-send attempt for one announcement.
 *
 * Counts only — no per-recipient row. An announcement to every volunteer would
 * otherwise write thousands of rows nobody reads, and the operational question
 * is "did it go out, and how many failed?", not "what happened to each
 * address". Failures keep their addresses so they can be retried.
 */
model AnnouncementDelivery {
  id             String   @id @default(cuid())
  announcementId String

  /** "email" today; "sms" if that is ever added. */
  channel   String   @default("email")
  /** True when this was a test send to the administrator only. */
  isTest    Boolean  @default(false)

  recipients Int      @default(0)
  succeeded  Int      @default(0)
  failed     Int      @default(0)
  /** Addresses the provider rejected, so a retry knows who to chase. */
  failures   Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  triggeredById String?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, startedAt])
  @@map("announcement_deliveries")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// Public testimony submissions from the homepage.
/// Nothing here is shown publicly until an administrator approves it.
model TestimonySubmission {
  id          String           @id @default(cuid())
  title       String?
  body        String
  authorName  String
  email       String
  phone       String?
  country     String
  isAnonymous Boolean          @default(false)
  consentToPublish Boolean     @default(false)
  status      SubmissionStatus @default(PENDING)
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
  ip          String?
  userAgent   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  /**
   * Moderation workload.
   *
   * Assignment is advisory: it says who is looking after a submission so two
   * moderators do not both draft a reply to the same person, but it never
   * blocks somebody else from acting — with 103 in the queue, a lock that
   * outlives its owner's shift would be worse than an occasional double-read.
   */
  assignedToId String?

  /**
   * SHA-256 of the normalised body (lower-cased, whitespace collapsed).
   *
   * What makes duplicate detection a lookup instead of an opinion: two
   * submissions with the same hash are the same words, however the author
   * re-typed the spacing. Backfilled by migration, maintained on write.
   */
  bodyHash String?

  /** Confirmed spam. Kept, not deleted, so the pattern stays visible. */
  isSpam Boolean @default(false)
  /**
   * Generated by an automated test run rather than a person. Tagged so the
   * queue can hide it and non-production cleanup can remove it safely —
   * mixed in with real submissions it drowns the moderators.
   */
  isTestData Boolean @default(false)

  /** Chosen for the homepage. Null means never featured. */
  featuredAt DateTime?

  reviewedBy User?  @relation("TestimonyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignedTo User?  @relation("TestimonyAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      TestimonyNote[]

  @@index([status, createdAt])
  @@index([bodyHash])
  @@index([assignedToId, status])
  @@map("testimony_submissions")
}

/**
 * The moderation conversation about one testimony, in order.
 *
 * Replaces the single overwritable `reviewNote` string: a submission that has
 * been declined, discussed and reopened has a history, and "who said what,
 * when" is exactly what the next moderator needs. `reviewNote` stays for old
 * reads; every historic value was copied in here by the migration.
 */
model TestimonyNote {
  id           String @id @default(cuid())
  testimonyId  String
  authorId     String?
  body         String
  createdAt    DateTime @default(now())

  testimony TestimonySubmission @relation(fields: [testimonyId], references: [id], onDelete: Cascade)
  author    User?               @relation("TestimonyNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([testimonyId, createdAt])
  @@map("testimony_notes")
}

/// Email addresses collected by the "stay updated" form.
/**
 * Messages sent from the public contact page.
 *
 * Never rendered publicly — the only way to read one is through the admin inbox,
 * which requires a permission. Stored rather than emailed onward so nothing is
 * lost if mail delivery fails, and so the organisation has a record of what was
 * asked and whether it was answered.
 */
model ContactMessage {
  id        String          @id @default(cuid())
  category  ContactCategory @default(GENERAL)
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus   @default(NEW)

  handledById String?
  handledAt   DateTime?
  handlerNote String?

  /** Set the first time anybody opens it. Null is what "unread" means. */
  firstReadAt DateTime?

  priority ContactPriority @default(NORMAL)

  /** Advisory — says who is drafting the reply, never locks others out. */
  assignedToId String?

  /**
   * SHA-256 of the normalised message body, same rule as testimonies
   * (src/lib/testimonies/hash.ts). The public form retries on slow networks
   * and people press send twice; the same words from the same address are one
   * enquiry, and the inbox should say so instead of showing seventy copies.
   */
  messageHash String?

  isSpam     Boolean @default(false)
  isTestData Boolean @default(false)

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledBy  User? @relation("ContactHandler", fields: [handledById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      ContactNote[]

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([messageHash])
  @@index([assignedToId, status])
  @@map("contact_messages")
}

/**
 * The team's working notes on one message, in order — who checked what, who
 * was asked, what was promised. Replaces the single overwritable
 * `handlerNote`, whose historic values the migration copies in here.
 */
model ContactNote {
  id        String   @id @default(cuid())
  messageId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  message ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User?          @relation("ContactNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
  @@map("contact_notes")
}

/**
 * One CSV import of users from a previous edition.
 *
 * `fileChecksum` is what makes the whole operation idempotent: re-uploading the
 * same file for the same edition is detected before any row is written, so a
 * nervous administrator pressing import twice cannot double-create accounts.
 */
model MigrationBatch {
  id        String @id @default(cuid())
  /** Human-quotable identifier, e.g. MIG-2026-0007. */
  reference String @unique
  name      String

  /** The edition these people took part in, as free text plus a parsed year. */
  sourceEdition String
  sourceYear    Int?
  sourceNote    String?

  originalFilename String
  /** SHA-256 of the uploaded bytes. */
  fileChecksum     String
  /**
   * Where the uploaded CSV is kept.
   *
   * A private storage key, never a path under ./public — the file is a list of
   * thousands of people's names, emails and phone numbers, and must not be
   * fetchable by anyone who guesses a URL. Cleared when the file is deleted
   * under the retention policy, which is what `fileDeletedAt` records; the
   * parsed rows survive in `MigratedUserRecord.sourceData` so a failed import
   * can still be explained and retried without the original.
   */
  storageKey    String?
  fileSizeBytes Int?
  fileDeletedAt DateTime?

  /** Header row → canonical field name, as chosen by the administrator. */
  columnMapping    Json

  sendInvitations Boolean @default(false)
  /**
   * When the upload-time "send invitations" choice was honoured. A one-shot
   * guard: the auto-queue on completion fires only while this is null, set via
   * an atomic updateMany so concurrent workers cannot both fire it. Backfilled
   * to now() for historical batches so the auto-queue never fires
   * retroactively on data imported before this existed.
   */
  invitationsAutoQueuedAt DateTime?

  status MigrationBatchStatus @default(DRAFT)

  totalRows   Int @default(0)
  validRows   Int @default(0)
  warningRows Int @default(0)
  invalidRows Int @default(0)
  createdRows Int @default(0)
  matchedRows Int @default(0)
  skippedRows Int @default(0)
  failedRows  Int @default(0)

  createdById String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User?                 @relation("MigrationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  records   MigratedUserRecord[]
  jobs      ImportJob[]
  participations PreviousEditionParticipation[]
  outreachRuns   OutreachRun[]

  // The same file twice for the same edition is the same import.
  @@unique([fileChecksum, sourceEdition])
  @@index([status, createdAt])
  @@map("migration_batches")
}

/**
 * One row of one CSV, kept for the life of the batch.
 *
 * `sourceData` holds the raw row so a failed import can be explained and
 * retried without the original file, which is deleted on a retention schedule.
 */
model MigratedUserRecord {
  id       String @id @default(cuid())
  batchId  String
  rowNumber Int

  sourceData Json

  /** Lower-cased and trimmed. The only key matching is performed on. */
  normalisedEmail String
  firstName       String?
  lastName        String?
  phone           String?
  previousRegistrationId String?
  previousDepartment     String?

  action MigrationRowAction @default(CREATE)
  status MigrationRowStatus @default(PENDING)
  /** Field-level messages: [{ field, level, message }]. */
  validationMessages Json?

  matchedUserId String?

  invitationStatus InvitationStatus @default(NOT_QUEUED)
  invitedAt        DateTime?
  invitationError  String?
  /** Set once, so a retried job never sends a second invitation. */
  invitationSentKey String? @unique

  activatedAt       DateTime?
  profileReviewedAt DateTime?
  excludedFromInvites Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch       MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedUser User?          @relation("MigratedRecordUser", fields: [matchedUserId], references: [id], onDelete: SetNull)
  outreachAttempts OutreachAttempt[] @relation("RecordOutreachAttempts")

  // A row number is unique within its batch, which makes re-processing a
  // chunk safe: the upsert target is deterministic.
  @@unique([batchId, rowNumber])
  @@index([normalisedEmail])
  @@index([batchId, status])
  @@index([invitationStatus])
  // Person-level joins (every activation and stage query goes user → rows).
  @@index([matchedUserId])
  @@map("migrated_user_records")
}

/**
 * Participation in an earlier edition.
 *
 * Deliberately its own table rather than a VolunteerApplication: a migrated
 * person has *not* applied for the current edition, and representing history as
 * a current application would corrupt every count on the dashboard.
 */
model PreviousEditionParticipation {
  id     String @id @default(cuid())
  userId String
  edition String
  year    Int?

  previousDepartment     String?
  previousRegistrationId String?
  metadata               Json?

  batchId   String?
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch MigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // One participation record per person per edition, so a re-run updates
  // rather than accumulating duplicates.
  @@unique([userId, edition])
  @@index([edition])
  @@map("previous_edition_participations")
}

/**
 * Database-backed job queue.
 *
 * There is no Redis in this stack and adding one for a few thousand rows would
 * be a large operational cost for little gain. PostgreSQL already gives the
 * two things a queue needs — durability and `SELECT ... FOR UPDATE SKIP LOCKED`
 * for safe concurrent claiming — so the queue lives here.
 */
model ImportJob {
  id      String @id @default(cuid())
  batchId String
  kind    String // "import" | "invite"

  status     JobStatus @default(PENDING)
  /** Rows [offset, offset + size) of the batch. */
  offset     Int       @default(0)
  size       Int       @default(100)
  attempts   Int       @default(0)
  maxAttempts Int      @default(3)
  lastError  String?

  claimedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batch MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // One job per chunk per kind — the guard against queueing a batch twice.
  @@unique([batchId, kind, offset])
  @@index([status, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Outreach — every bulk email to participants, as auditable runs and attempts
// ---------------------------------------------------------------------------

enum OutreachKind {
  /// The one-time migration invitation. One-send protection lives on the
  /// record's invitationSentKey, exactly as before.
  INVITATION
  /// "Activate your account" — imported people who cannot yet sign in.
  REMINDER_UNACTIVATED
  /// "Confirm your availability" — anyone with a usable account and no
  /// confirmed participation for the edition.
  REMINDER_UNCONFIRMED
}

enum OutreachRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  CANCELLED
}

enum OutreachAttemptStatus {
  QUEUED
  /// Claimed by a worker. Orphans (worker crash) are swept back to QUEUED
  /// after 15 minutes — worst case a delayed send, never a duplicate.
  SENDING
  /// The mail transport accepted the message. Whether it was *delivered* is a
  /// different fact this system does not know (no provider webhook); see
  /// `mailerMode` for what "accepted" meant.
  SENT
  FAILED
  /// No longer eligible when the worker reached it (activated meanwhile,
  /// excluded, confirmed, inside cooldown). The reason is in `error`.
  SKIPPED
}

/**
 * One administrator-triggered send run — an invitation wave or a reminder
 * campaign. The run records the audience definition it was approved with
 * (`filtersJson`, the counted-bulk contract's evidence) and per-status totals;
 * the per-recipient truth lives in OutreachAttempt.
 */
model OutreachRun {
  id          String       @id @default(cuid())
  kind        OutreachKind
  /// Edition the run was created for, snapshotted from eventConfig.
  edition     String
  templateKey String
  /// Set for INVITATION runs only.
  batchId     String?
  /// Audience snapshot shown in the confirmation dialog.
  filtersJson Json?

  cooldownDays  Int @default(7)
  maxRecipients Int @default(500)

  plannedCount Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  /**
   * 'smtp' | 'file'. With no SMTP configured the mailer writes files to
   * ./storage/mail and still reports success — recording the mode here is what
   * keeps a development run visibly non-real in every report built on it.
   */
  mailerMode String

  status      OutreachRunStatus @default(QUEUED)
  createdById String?
  createdAt   DateTime          @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  createdBy User?             @relation("OutreachRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  batch     MigrationBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attempts  OutreachAttempt[]
  jobs      OutreachJob[]

  @@index([kind, createdAt])
  @@index([status])
  @@map("outreach_runs")
}

/**
 * One recipient of one run. Append-only: history is never rewritten, which is
 * what makes "how many attempts did this person get, and when?" answerable —
 * the question the old invitation pipeline could not answer.
 */
model OutreachAttempt {
  id       String  @id @default(cuid())
  runId    String
  userId   String?
  /// The MigratedUserRecord, for INVITATION runs.
  recordId String?
  /// Address actually attempted, snapshotted — the account's email can change.
  email    String

  /// Denormalised from the run so the cooldown predicate reads one table.
  kind OutreachKind

  status     OutreachAttemptStatus @default(QUEUED)
  error      String?
  mailerMode String?
  queuedAt   DateTime              @default(now())
  /** When a worker claimed it — how SENDING orphans are aged for the sweep. */
  claimedAt  DateTime?
  sentAt     DateTime?

  /// `${runId}:${userId ?? recordId}` — one attempt per recipient per run,
  /// whatever double-clicks, retries or concurrent workers do.
  dedupeKey String @unique

  run    OutreachRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  user   User?               @relation("OutreachAttempts", fields: [userId], references: [id], onDelete: SetNull)
  record MigratedUserRecord? @relation("RecordOutreachAttempts", fields: [recordId], references: [id], onDelete: SetNull)

  @@index([userId, status, sentAt])
  @@index([runId, status])
  @@map("outreach_attempts")
}

/**
 * Queue chunks for one outreach run. Same claiming discipline as ImportJob
 * (FOR UPDATE SKIP LOCKED), but keyed by a per-run sequence number: a new run
 * always gets fresh jobs, so "re-queue created nothing because the offsets
 * already existed" — the bug that silently stranded half the invitation
 * queue — cannot recur by construction. `size` matches what one pass actually
 * sends, so the job count always equals send capacity.
 */
model OutreachJob {
  id    String @id @default(cuid())
  runId String
  seq   Int

  status      JobStatus @default(PENDING)
  size        Int       @default(50)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?

  claimedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  run OutreachRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([status, createdAt])
  @@map("outreach_jobs")
}

// ---------------------------------------------------------------------------
// Manual follow-up — the phone-bank's memory
// ---------------------------------------------------------------------------

enum ContactChannel {
  PHONE
  WHATSAPP
  SMS
  EMAIL
  IN_PERSON
  OTHER
}

/**
 * What the member of staff concluded — deliberately NOT the participant's
 * response state, which lives on the authoritative records (activation on the
 * user, confirmation on the participation). The due-queue derives "resolved by
 * an actual response" instead of anyone editing these rows.
 */
enum ContactOutcome {
  AWAITING_RESPONSE
  NEEDS_ASSISTANCE
  DECLINED
  UNREACHABLE
  RESOLVED
}

/**
 * One manual contact with one participant. Append-only — a correction is a
 * new entry, so the history of who said what, when, survives everybody.
 */
model ParticipantContactLog {
  id      String  @id @default(cuid())
  userId  String
  adminId String?

  channel        ContactChannel
  outcome        ContactOutcome
  notes          String?
  contactedAt    DateTime       @default(now())
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())

  user  User  @relation("ContactLogSubject", fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("ContactLogAuthor", fields: [adminId], references: [id], onDelete: SetNull)

  // Latest-per-person lookups and the due/overdue queue.
  @@index([userId, contactedAt(sort: Desc)])
  @@index([nextFollowUpAt])
  @@map("participant_contact_logs")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentGiven   Boolean   @default(false)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String    @default("homepage")
  ip             String?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
