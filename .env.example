# ---------------------------------------------------------------------------
# MMPraise Volunteer Registration — environment variables
# Copy to .env.local (development) or set in your host's config (production).
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_NAME="MMPraise Volunteer Registration"
APP_URL=http://localhost:3000
# Used to sign session cookies and hash tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-me-with-a-long-random-value

# Database (PostgreSQL 14+)
DATABASE_URL=postgresql://USER@127.0.0.1:5432/mmp_registration?schema=public
# Separate database used by the integration test suite.
TEST_DATABASE_URL=postgresql://USER@127.0.0.1:5432/mmp_registration_test?schema=public
# Production (Docker): Postgres runs as the `db` compose service. Set a long
# random password here and point DATABASE_URL at
#   postgresql://mmp:<POSTGRES_PASSWORD>@db:5432/mmp_registration
POSTGRES_PASSWORD=

# Sessions
SESSION_TTL_HOURS=168          # 7 days
SESSION_COOKIE_NAME=mmp_session

# File storage: "local" in development, "s3" in production.
STORAGE_DRIVER=local
# Local driver: files are written outside the web root and served only through
# an authorised route handler. Never place this inside ./public.
STORAGE_LOCAL_PATH=./storage/uploads
MAX_UPLOAD_MB=5

# S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for MinIO / Cloudflare R2 / DigitalOcean Spaces
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional: AES256 or aws:kms. Leave empty unless the store has an encryption key
# configured. A MinIO without a KMS key rejects every upload that asks for this.
S3_SERVER_SIDE_ENCRYPTION=

# Email. Leave SMTP_HOST empty in development to write emails to ./storage/mail
# instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MMPraise Volunteers <volunteers@mmpraise.org>"
SUPPORT_EMAIL=volunteers@mmpraise.org

# Rate limiting (fixed window, database backed)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MIN=60

# Bootstrap super administrator created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@mmpraise.org
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ---------------------------------------------------------------------------
# Public site (homepage)
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at BUILD time,
# so changing any of them requires a rebuild/redeploy — not just a restart.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mmpraise.org

# Event facts. The duration rises by one hour per edition (2026 = 84, 2027 = 85).
NEXT_PUBLIC_EVENT_EDITION=2027
NEXT_PUBLIC_EVENT_DURATION_HOURS=85
# ISO 8601 with timezone, e.g. 2027-03-04T18:00:00+01:00.
# Leave EMPTY until the date is confirmed: the countdown then shows
# "date to be announced" and the Event structured data is omitted.
NEXT_PUBLIC_EVENT_STARTS_AT=
NEXT_PUBLIC_EVENT_ENDS_AT=
NEXT_PUBLIC_EVENT_VENUE="RCCG Prayer Foyer, New Arena"
NEXT_PUBLIC_EVENT_VENUE_ADDRESS="3km by 3km, Redemption City, Nigeria"
NEXT_PUBLIC_EVENT_NATIONS=82
NEXT_PUBLIC_EVENT_THEME=

# Contact details. The phone renders only when set — the current site
# publishes the literal placeholder "+234 XXX-XXXX-XXX", which is not carried over.
NEXT_PUBLIC_CONTACT_EMAIL=info@mmpraise.org
# Published on the current contact page. Rendered site-wide; never leave a placeholder here.
NEXT_PUBLIC_CONTACT_PHONE="+234 703 385 3817"
NEXT_PUBLIC_CONTACT_ADDRESS="Marathon Messiah's Praise HQ, Lagos, Nigeria"
# Where visitors are told to come, as published on the contact page.
NEXT_PUBLIC_VISIT_ADDRESS="MMPraise, Redemption Camp, Ogun State, Nigeria"
NEXT_PUBLIC_VISIT_MAP_URL=https://maps.google.com/?q=Redemption+Camp,+Ogun+State,+Nigeria

# Social profiles. Each icon renders only when its URL is set — no dead icons.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ---------------------------------------------------------------------------
# Launch flags
#
# For the first release only the homepage and the registration journey are
# live. Everything below renders as "Coming soon" until you set it to "true"
# and redeploy. The registration journey (/register, /login, /apply,
# /dashboard, password reset, email verification), the admin area and the legal
# pages are ALWAYS on and have no flag — registration cannot work without them.
# ---------------------------------------------------------------------------

# Live by default.
NEXT_PUBLIC_FEATURE_LIVESTREAM=true      # existing YouTube channel
NEXT_PUBLIC_FEATURE_SHARE_TESTIMONY=true # on-page form, moderated before publishing
NEXT_PUBLIC_FEATURE_NEWSLETTER=true      # on-page signup

# Coming soon. Flip to "true" and redeploy when the destination is ready.
NEXT_PUBLIC_FEATURE_GIVE=false           # donations — see note in docs/DEPLOYMENT.md
NEXT_PUBLIC_FEATURE_ABOUT=true       # /about is built and live
NEXT_PUBLIC_FEATURE_BLOG=false
NEXT_PUBLIC_FEATURE_GALLERY=false
NEXT_PUBLIC_FEATURE_MAGAZINE=false
NEXT_PUBLIC_FEATURE_RADIO=false
NEXT_PUBLIC_FEATURE_PRAYER_REQUEST=false
NEXT_PUBLIC_FEATURE_CONTACT=true     # /contact is built and live

# Destinations used once the matching flag above is "true".
NEXT_PUBLIC_REGISTRATION_URL=/register
NEXT_PUBLIC_VOLUNTEER_URL=/register
NEXT_PUBLIC_DONATION_URL=https://mmpraise.org/donate/
NEXT_PUBLIC_LIVESTREAM_URL=https://www.youtube.com/@themmpraise
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@themmpraise
NEXT_PUBLIC_ABOUT_URL=/about
NEXT_PUBLIC_BLOG_URL=https://mmpraise.org/blog/
NEXT_PUBLIC_GALLERY_URL=https://mmpraise.org/gallery/
NEXT_PUBLIC_PRAYER_REQUEST_URL=https://mmpraise.org/prayer-request/
NEXT_PUBLIC_CONTACT_URL=/contact
NEXT_PUBLIC_RADIO_URL=
NEXT_PUBLIC_MAGAZINE_URL=

# ---------------------------------------------------------------------------
# Docker deployment only (read by docker-compose.yml and docker/Caddyfile).
# Not used when running locally or on a platform that terminates TLS for you.
# ---------------------------------------------------------------------------
# The bare domain the certificate is issued for — no scheme, no trailing slash.
SITE_DOMAIN=mmpraise.org
# Where Let's Encrypt sends certificate expiry warnings.
ACME_EMAIL=info@mmpraise.org
